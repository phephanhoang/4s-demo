{
  "name": "4s-demo",
  "compatibility_date": "2026-11-20",
  "routes": [
    { "pattern": "n.abework.space", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash"
  },
  "observability": {
    "enabled": false
  }
}
